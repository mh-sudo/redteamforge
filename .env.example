# Bind address for dev/preview servers. Docker sets 0.0.0.0 internally.
# HOST=0.0.0.0
# PORT=8080

# Optional page password. Unset = open (fine for localhost; set this before
# exposing the app on a network — see "Deployment" in the README).
# AUTH_PASSWORD=

# Force the Secure flag on the gate cookie (set when serving via HTTPS).
# AUTH_COOKIE_SECURE=1

# Allow https provider endpoints on private/LAN addresses (self-hosted
# models like vLLM). Allowed implicitly when AUTH_PASSWORD is set.
# RTF_ALLOW_PRIVATE_ENDPOINTS=1
